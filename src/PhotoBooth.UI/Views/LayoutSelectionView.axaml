<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:PhotoBooth.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="PhotoBooth.UI.Views.LayoutSelectionView"
             x:DataType="vm:LayoutSelectionViewModel">

    <UserControl.Styles>
        <!-- Image Button Style -->
        <Style Selector="Button.ImageBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      CornerRadius="{TemplateBinding CornerRadius}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <!-- Pressed State -->
        <Style Selector="Button.ImageBtn:pressed > Image">
             <Setter Property="RenderTransform" Value="scale(0.92)"/>
        </Style>
        <Style Selector="Button.ImageBtn:pressed /template/ ContentPresenter">
             <Setter Property="RenderTransform" Value="scale(0.92)"/>
             <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- PointerOverlay State -->
        <Style Selector="Button.ImageBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- Focus State -->
        <Style Selector="Button.ImageBtn:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Background Image (Always Fills Screen) -->
        <Image Source="/Assets/backgrounds/back2.png" 
               Stretch="UniformToFill"/>
        
        <!-- Content Scaler: Ensures UI looks the same on all screens -->
        <Viewbox Stretch="Uniform">
            <!-- Reference Design Size: 1920x1080 -->
            <Grid Width="1920" Height="1080">
                
                <!-- Layout Cards - Center -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="280">
                    
                    <!-- Layout 6 ảnh Button -->
                    <Button Command="{Binding SelectLayout6Command}"
                            Classes="ImageBtn"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <Binding Path="SelectedLayoutId" 
                                     Converter="{x:Static converters:SelectionScaleConverter.Instance}" 
                                     ConverterParameter="layout6"/>
                        </Button.RenderTransform>
                        
                        <Panel>
                             <Border CornerRadius="15" Background="Transparent">
                                 <Image Source="/Assets/frames/nen6_1.png" Height="500"/>
                             </Border>
                        </Panel>
                    </Button>
                    
                    <!-- Layout 2 ảnh Button -->
                    <Button Command="{Binding SelectLayout2Command}"
                            Classes="ImageBtn"
                            Cursor="Hand"
                            Margin="0,0,100,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <Binding Path="SelectedLayoutId" 
                                     Converter="{x:Static converters:SelectionScaleConverter.Instance}" 
                                     ConverterParameter="layout2"/>
                        </Button.RenderTransform>

                        <Panel>
                            <!-- Two nen2_1 overlapping slightly -->
                            <Image Source="/Assets/frames/nen2_1.png" Height="500"
                                   Margin="100,0,0,100"/>
                            <Image Source="/Assets/frames/nen2_1.png" Height="500"
                                   Margin="0,100,50,0"/>
                        </Panel>
                    </Button>

                </StackPanel>
                
                <!-- Warning Message -->
                <Border Background="#e94560" CornerRadius="12" Padding="20,12"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,180"
                        IsVisible="{Binding WarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding WarningMessage}" 
                               Foreground="White" FontSize="28" FontWeight="Bold"/>
                </Border>
                
                <!-- Back Button -->
                <Button Command="{Binding GoBackCommand}"
                        Classes="ImageBtn"
                        Width="200"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="60,0,0,0"
                        Cursor="Hand"
                        RenderTransformOrigin="0.5,0.5">
                    <Image Source="/Assets/buttons/back.png"/>
                </Button>
                
                <!-- Next Button -->
                <Button Command="{Binding GoNextCommand}"
                        Classes="ImageBtn"
                        Width="200"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,60,0"
                        Cursor="Hand"
                        RenderTransformOrigin="0.5,0.5">
                    <Image Source="/Assets/buttons/next.png"/>
                </Button>
            </Grid>
        </Viewbox>
    </Grid>

</UserControl>
