<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="PhotoBooth.UI.Views.StickerView"
             x:DataType="vm:StickerViewModel">

    <Grid Background="#1a1a2e" ColumnDefinitions="*,350">
        
        <!-- Preview Area -->
        <Grid Grid.Column="0" Margin="40">
            <Border Background="#16213e" CornerRadius="20">
                <TextBlock Text="Preview với Stickers" 
                           FontSize="32"
                           Foreground="#666"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
        
        <!-- Sticker Panel -->
        <Grid Grid.Column="1" Background="#16213e" RowDefinitions="Auto,*,Auto">
            
            <TextBlock Grid.Row="0" 
                       Text="THÊM STICKER" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#e94560"
                       HorizontalAlignment="Center"
                       Margin="0,30"/>
            
            <!-- Available Stickers -->
            <ScrollViewer Grid.Row="1" Margin="20">
                <ItemsControl ItemsSource="{Binding AvailableStickers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding $parent[ItemsControl].((vm:StickerViewModel)DataContext).AddStickerCommand}"
                                    CommandParameter="{Binding}"
                                    Margin="5"
                                    Width="80" Height="80"
                                    Background="#0f3460"
                                    CornerRadius="10">
                                <TextBlock Text="⭐" FontSize="32"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Spacing="10" Margin="20">
                <Button Command="{Binding ConfirmCommand}"
                        Content="Tiếp tục →"
                        Background="#e94560"
                        Foreground="White"
                        FontSize="18"
                        Height="50"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"/>
                
                <Button Command="{Binding SkipCommand}"
                        Content="Bỏ qua"
                        Background="#0f3460"
                        Foreground="White"
                        FontSize="16"
                        Height="40"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"/>
                
                <Button Command="{Binding GoBackCommand}"
                        Content="← Quay lại"
                        Background="Transparent"
                        Foreground="#888"
                        FontSize="14"
                        HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
