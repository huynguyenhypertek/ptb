<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.Admin.ViewModels"
             x:Class="PhotoBooth.Admin.Views.SessionListView"
             x:DataType="vm:SessionListViewModel">
    
    <Grid RowDefinitions="Auto,Auto,*" Margin="20">
        <!-- Header -->
        <Grid Margin="0,0,0,15">
            <TextBlock Text="📋 Danh sách lượt chụp" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <!-- Total amount -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="💰 Tổng:" Foreground="#888" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{Binding TotalAmount}" Foreground="#f59e0b" FontWeight="Bold" 
                                   VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                </Border>
                <Button Content="📥 Xuất CSV" Command="{Binding ExportCsvCommand}"
                        Background="#166534" Foreground="White" CornerRadius="8" Padding="12,8"/>
                <Button Content="🗑️ Reset" Command="{Binding RequestResetCommand}"
                        Background="#7f1d1d" Foreground="White" CornerRadius="8" Padding="12,8"
                        IsVisible="{Binding !IsConfirmingReset}"/>
                <Button Content="🔄 Làm mới" Command="{Binding LoadSessionsCommand}"
                        Background="#2a2a3e" Foreground="White" CornerRadius="8" Padding="12,8"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Confirmation bar + Export status (stacked, individually toggled) -->
        <StackPanel Grid.Row="1">
            <!-- Confirmation bar (shown when Reset is clicked) -->
            <Border Background="#450a0a" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                    IsVisible="{Binding IsConfirmingReset}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="⚠️ Xóa sạch toàn bộ lượt chụp? Không thể hoàn tác!"
                               Foreground="#fca5a5" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="✅ Xác nhận xóa" Command="{Binding ConfirmResetCommand}"
                            Background="#dc2626" Foreground="White" CornerRadius="6" Padding="10,6"/>
                    <Button Content="Hủy" Command="{Binding CancelResetCommand}"
                            Background="#374151" Foreground="White" CornerRadius="6" Padding="10,6"/>
                </StackPanel>
            </Border>

            <!-- Export / Reset status message -->
            <TextBlock Text="{Binding ExportStatus}" Foreground="#86efac" FontSize="13"
                       Margin="0,0,0,10" IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <!-- Sessions Table -->
        <Border Grid.Row="2" Background="#1e1e2e" CornerRadius="12" Padding="5">
            <DataGrid ItemsSource="{Binding Sessions}" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="50"/>
                    <DataGridTextColumn Header="Thiết bị" Binding="{Binding DeviceId, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="Layout" Binding="{Binding LayoutUsed, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="Khung" Binding="{Binding FrameUsed, Mode=OneWay}" Width="100"/>
                    <DataGridTextColumn Header="Ảnh chọn" Binding="{Binding PhotoCount, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="Tổng chụp" Binding="{Binding TotalCaptured, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="💰 Số tiền" Binding="{Binding AmountFormatted, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAtFormatted, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading -->
        <TextBlock Grid.Row="2" Text="Đang tải..." Foreground="#888" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsLoading}"/>
    </Grid>
</UserControl>
