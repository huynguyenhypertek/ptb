<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.Admin.ViewModels"
             x:Class="PhotoBooth.Admin.Views.PlanListView"
             x:DataType="vm:PlanListViewModel">
    
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">
        <!-- Header -->
        <Grid Margin="0,0,0,15">
            <TextBlock Text="📦 Quản lý gói Subscription" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="➕ Tạo gói" Command="{Binding ShowCreateFormCommand}"
                        Background="#7c3aed" Foreground="White" CornerRadius="8" Padding="12,8"/>
                <Button Content="✏️ Sửa" Command="{Binding EditPlanCommand}"
                        Background="#f59e0b" Foreground="White" CornerRadius="8" Padding="12,8"/>
                <Button Content="🗑️ Xóa" Command="{Binding DeletePlanCommand}"
                        Background="#e94560" Foreground="White" CornerRadius="8" Padding="12,8"/>
                <Button Content="🔄" Command="{Binding LoadPlansCommand}"
                        Background="#2a2a3e" Foreground="White" CornerRadius="8" Padding="12,8"/>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#f0c040" FontSize="14"
                   Margin="0,0,0,10"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Create/Edit Form -->
        <Border Grid.Row="2" Background="#2a2a3e" CornerRadius="12" Padding="20" Margin="0,0,0,15"
                IsVisible="{Binding ShowForm}">
            <StackPanel Spacing="10">
                <TextBlock Text="Thông tin gói" FontSize="18" FontWeight="Bold" Foreground="White"/>
                
                <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Tên gói" Foreground="#ccc" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormName}" Watermark="Basic / Pro / Premium"
                                 Padding="10,8" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Giá (VNĐ/tháng)" Foreground="#ccc" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormPrice}" Watermark="500000"
                                 Padding="10,8" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mô tả" Foreground="#ccc" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormDescription}" Watermark="Mô tả gói"
                                 Padding="10,8" CornerRadius="6"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*,*" HorizontalAlignment="Stretch">
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Max máy chụp" Foreground="#ccc" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormMaxDevices}" Watermark="5"
                                 Padding="10,8" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Max ảnh/ngày" Foreground="#ccc" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormMaxPhotos}" Watermark="500"
                                 Padding="10,8" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <CheckBox Content="Khung nền riêng" IsChecked="{Binding FormHasFrames}" 
                                  Foreground="#ccc"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <CheckBox Content="Thống kê nâng cao" IsChecked="{Binding FormHasAnalytics}"
                                  Foreground="#ccc"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <CheckBox Content="Đang hoạt động" IsChecked="{Binding FormIsActive}"
                                  Foreground="#ccc"/>
                    </StackPanel>
                </Grid>
                
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                    <Button Content="💾 Lưu" Command="{Binding SavePlanCommand}"
                            Background="#22c55e" Foreground="White" CornerRadius="6" Padding="16,8"/>
                    <Button Content="Hủy" Command="{Binding CancelFormCommand}"
                            Background="#555" Foreground="White" CornerRadius="6" Padding="16,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Plans Cards -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Plans}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1e1e2e" CornerRadius="12" Margin="0,0,12,12"
                                Padding="20" Width="280"
                                PointerPressed="OnPlanClicked">
                            <StackPanel Spacing="8">
                                <!-- Plan Name + Badge -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                    <Border Background="#22c55e"
                                            CornerRadius="8" Padding="6,2" VerticalAlignment="Center"
                                            IsVisible="{Binding IsActive}">
                                        <TextBlock Text="Active" Foreground="White" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding Description}" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
                                
                                <!-- Price -->
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,5,0,5">
                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N0}'}" 
                                               FontSize="28" FontWeight="Bold" Foreground="#7c3aed"/>
                                    <TextBlock Text="đ/tháng" Foreground="#888" FontSize="12" 
                                               VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </StackPanel>

                                <Border Height="1" Background="#333" Margin="0,5"/>

                                <!-- Features -->
                                <StackPanel Spacing="4">
                                    <TextBlock Foreground="#ccc" FontSize="13">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="📷 Tối đa {0} máy chụp">
                                                <Binding Path="MaxDevices"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Foreground="#ccc" FontSize="13">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="🖼️ {0} ảnh/ngày">
                                                <Binding Path="MaxPhotosPerDay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="🎨 Khung nền riêng" Foreground="#22c55e" FontSize="13"
                                               IsVisible="{Binding HasCustomFrames}"/>
                                    <TextBlock Text="📊 Thống kê nâng cao" Foreground="#22c55e" FontSize="13"
                                               IsVisible="{Binding HasAnalytics}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="Đang tải..." Foreground="#888" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsLoading}"/>
    </Grid>
</UserControl>
