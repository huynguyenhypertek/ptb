<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.Admin.ViewModels"
             x:Class="PhotoBooth.Admin.Views.FrameListView"
             x:DataType="vm:FrameListViewModel">
    
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="20">
        <!-- Header -->
        <Grid Margin="0,0,0,15">
            <TextBlock Text="🎨 Quản lý khung nền" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="📁 Thêm khung" Command="{Binding UploadFrameCommand}"
                        Background="#7c3aed" Foreground="White" CornerRadius="8" Padding="12,8"/>
                <Button Content="🏪 Cấp cho CH" Command="{Binding ShowAssignCommand}"
                        Background="#22c55e" Foreground="White" CornerRadius="8" Padding="12,8"
                        IsVisible="{Binding IsSystemAdmin}"/>
                <Button Content="🗑️ Xóa" Command="{Binding DeleteFrameCommand}"
                        Background="#e94560" Foreground="White" CornerRadius="8" Padding="12,8"/>
                <Button Content="🔄" Command="{Binding LoadFramesCommand}"
                        Background="#2a2a3e" Foreground="White" CornerRadius="8" Padding="12,8"/>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#f0c040" FontSize="14"
                   Margin="0,0,0,10"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Layout Tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,0,0,15">
            <Button Command="{Binding SelectTab2Command}"
                    Padding="20,10" CornerRadius="8" FontSize="15" FontWeight="Bold"
                    Foreground="White" Background="#2a2a3e"
                    Classes.selected="{Binding IsTab2Active}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📷" FontSize="16"/>
                    <TextBlock Text="Khung 2 ảnh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectTab6Command}"
                    Padding="20,10" CornerRadius="8" FontSize="15" FontWeight="Bold"
                    Foreground="White" Background="#2a2a3e"
                    Classes.selected="{Binding IsTab6Active}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📸" FontSize="16"/>
                    <TextBlock Text="Khung 6 ảnh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Assignment Panel -->
        <Border Grid.Row="3" Background="#2a2a3e" CornerRadius="12" Padding="16" Margin="0,0,0,15"
                IsVisible="{Binding ShowAssignPanel}">
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="🏪 Cấp khung cho cửa hàng" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <Button Content="✕ Đóng" Command="{Binding CloseAssignPanelCommand}"
                            HorizontalAlignment="Right" Background="#555" Foreground="White"
                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding AssignStores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StoreAssignItem}">
                            <Border Background="#1e1e2e" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StoreName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="✅ Đã cấp phép" Foreground="#22c55e" FontSize="11" 
                                                   IsVisible="{Binding IsAssigned}"/>
                                        <TextBlock Text="⬜ Chưa cấp" Foreground="#888" FontSize="11"
                                                   IsVisible="{Binding !IsAssigned}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="✅ Cấp" 
                                                Command="{Binding $parent[ItemsControl].((vm:FrameListViewModel)DataContext).AssignFrameCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#22c55e" Foreground="White" CornerRadius="6" 
                                                Padding="14,6" FontSize="13"
                                                IsVisible="{Binding !IsAssigned}"/>
                                        <Button Content="❌ Thu hồi"
                                                Command="{Binding $parent[ItemsControl].((vm:FrameListViewModel)DataContext).RevokeFrameCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#e94560" Foreground="White" CornerRadius="6"
                                                Padding="14,6" FontSize="13"
                                                IsVisible="{Binding IsAssigned}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Frame Grid Container -->
        <Panel Grid.Row="4">
            <!-- Tab: Layout 2 ảnh -->
            <ScrollViewer IsVisible="{Binding IsTab2Active}">
                <ItemsControl ItemsSource="{Binding Layout2Frames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FrameDisplayItem}">
                            <Border CornerRadius="12" Margin="0,0,12,12" Padding="10" Width="220"
                                    Background="#1e1e2e" Cursor="Hand"
                                    Classes.frameSelected="{Binding IsSelected}"
                                    PointerPressed="OnFrameClicked">
                                <StackPanel Spacing="8">
                                    <Border Background="#252540" CornerRadius="8" Height="280" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AssignedStoresText}" Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Tab: Layout 6 ảnh -->
            <ScrollViewer IsVisible="{Binding IsTab6Active}">
                <ItemsControl ItemsSource="{Binding Layout6Frames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FrameDisplayItem}">
                            <Border CornerRadius="12" Margin="0,0,12,12" Padding="10" Width="220"
                                    Background="#1e1e2e" Cursor="Hand"
                                    Classes.frameSelected="{Binding IsSelected}"
                                    PointerPressed="OnFrameClicked">
                                <StackPanel Spacing="8">
                                    <Border Background="#252540" CornerRadius="8" Height="280" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AssignedStoresText}" Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading -->
            <TextBlock Text="Đang tải..." Foreground="#888" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsLoading}"/>
        </Panel>
    </Grid>
    
    <UserControl.Styles>
        <Style Selector="Button.selected">
            <Setter Property="Background" Value="#7c3aed"/>
        </Style>
        <Style Selector="Border.frameSelected">
            <Setter Property="Background" Value="#2d1f5e"/>
            <Setter Property="BorderBrush" Value="#7c3aed"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
    </UserControl.Styles>
</UserControl>
