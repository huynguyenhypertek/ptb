<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.Admin.ViewModels"
             x:Class="PhotoBooth.Admin.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <!-- Header -->
            <Grid>
                <TextBlock Text="📊 Dashboard" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding LastUpdated, StringFormat='Cập nhật: {0}'}" 
                               Foreground="#888" VerticalAlignment="Center"/>
                    <Button Content="🔄 Làm mới" Command="{Binding LoadStatsCommand}"
                            Background="#2a2a3e" Foreground="White" CornerRadius="8" Padding="12,8"/>
                </StackPanel>
            </Grid>

            <!-- Stats Cards Row 1 -->
            <UniformGrid Columns="3" Margin="0,10,0,0">
                <!-- Total Sessions -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📸 Tổng lượt chụp" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TotalSessions}" FontSize="48" FontWeight="Bold"
                                   Foreground="#7c3aed" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today Sessions -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="📅 Hôm nay" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TodaySessions}" FontSize="48" FontWeight="Bold"
                                   Foreground="#e94560" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Photos -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🖼️ Tổng ảnh" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TotalPhotos}" FontSize="48" FontWeight="Bold"
                                   Foreground="#06d6a0" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Stats Cards Row 2: Revenue -->
            <UniformGrid Columns="2" Margin="0,0,0,0">
                <!-- Total Revenue -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="💰 Tổng doanh thu" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TotalRevenue}" FontSize="42" FontWeight="Bold"
                                   Foreground="#f59e0b" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today Revenue -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="💵 Doanh thu hôm nay" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TodayRevenue}" FontSize="42" FontWeight="Bold"
                                   Foreground="#22c55e" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Loading indicator -->
            <TextBlock Text="Đang tải..." Foreground="#888" FontSize="14"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsLoading}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
