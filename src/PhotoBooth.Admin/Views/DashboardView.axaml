<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.Admin.ViewModels"
             x:Class="PhotoBooth.Admin.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <!-- Header -->
            <Grid>
                <TextBlock Text="📊 Dashboard" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding LastUpdated, StringFormat='Cập nhật: {0}'}" 
                               Foreground="#888" VerticalAlignment="Center"/>
                    <Button Content="🔄 Làm mới" Command="{Binding LoadStatsCommand}"
                            Background="#2a2a3e" Foreground="White" CornerRadius="8" Padding="12,8"/>
                </StackPanel>
            </Grid>

            <!-- Stats Cards Row 1 -->
            <UniformGrid Columns="3" Margin="0,10,0,0">
                <!-- Total Sessions -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📸 Tổng lượt chụp" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TotalSessions}" FontSize="48" FontWeight="Bold"
                                   Foreground="#7c3aed" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today Sessions -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="📅 Hôm nay" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TodaySessions}" FontSize="48" FontWeight="Bold"
                                   Foreground="#e94560" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Photos -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🖼️ Tổng ảnh" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TotalPhotos}" FontSize="48" FontWeight="Bold"
                                   Foreground="#06d6a0" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Stats Cards Row 2: Revenue -->
            <UniformGrid Columns="2" Margin="0,0,0,0">
                <!-- Total Revenue -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="💰 Tổng doanh thu" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TotalRevenue}" FontSize="42" FontWeight="Bold"
                                   Foreground="#f59e0b" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today Revenue -->
                <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="💵 Doanh thu hôm nay" Foreground="#888" FontSize="14"/>
                        <TextBlock Text="{Binding TodayRevenue}" FontSize="42" FontWeight="Bold"
                                   Foreground="#22c55e" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick Launch Section -->
            <Border Background="#1e1e2e" CornerRadius="12" Padding="25" Margin="0,10,0,0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                        <TextBlock Grid.Column="0" Text="🚀 Khởi động nhanh PhotoBooth" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔄 Tải lại" 
                                Command="{Binding DeviceLauncher.LoadDevicesCommand}"
                                Background="#333" Foreground="White" CornerRadius="6" Padding="12,6"/>
                    </Grid>
                    
                    <ContentControl Content="{Binding DeviceLauncher}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="{x:Type vm:DeviceLauncherViewModel}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="⏳ Đang tải thiết bị..." Foreground="#888" IsVisible="{Binding IsLoading}"/>
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DeviceLaunchItem}">
                                                <Border Background="#2a2a3e" CornerRadius="8" Padding="12" Margin="0,2">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="18"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="White"/>
                                                                <Border Background="#1a3a1a" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsRunning}">
                                                                    <TextBlock Text="RUNNING" FontSize="10" Foreground="#22c55e" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding StoreDisplay}" FontSize="12" Foreground="#888"/>
                                                                <TextBlock Text="{Binding EnabledDisplay}" FontSize="12"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Panel Grid.Column="2" VerticalAlignment="Center">
                                                            <Button Content="▶ Khởi động"
                                                                    Command="{Binding $parent[ItemsControl].((vm:DeviceLauncherViewModel)DataContext).LaunchDeviceCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#22c55e" Foreground="White" CornerRadius="6" Padding="12,8"
                                                                    IsVisible="{Binding !IsRunning}"/>
                                                            <Button Content="⏸ Dừng"
                                                                    Command="{Binding $parent[ItemsControl].((vm:DeviceLauncherViewModel)DataContext).StopDeviceCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#e94560" Foreground="White" CornerRadius="6" Padding="12,8"
                                                                    IsVisible="{Binding IsRunning}"/>
                                                        </Panel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <Border Background="#333" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#ccc" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </StackPanel>
            </Border>

            <!-- Loading indicator -->
            <TextBlock Text="Đang tải..." Foreground="#888" FontSize="14"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsLoading}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
