<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.Event.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="PhotoBooth.Event.Views.PhotoSelectView"
             x:DataType="vm:PhotoSelectViewModel">

    <UserControl.Styles>
        <!-- Photo Thumbnail Button Style — transparent, no FluentTheme hover effects -->
        <Style Selector="Button.PhotoBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.PhotoBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Overlay Button Style — invisible button placed over background-drawn buttons.
             Custom template to remove all FluentTheme chrome. -->
        <Style Selector="Button.OverlayBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      CornerRadius="15"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.OverlayBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.OverlayBtn:pressed /template/ ContentPresenter">
            <!-- Subtle darkening on press for tactile feedback -->
            <Setter Property="Background" Value="#20000000"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Content Scaler — everything inside (including background) scales together -->
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">
                
                <!-- Background Image (Now scales synchronously with the UI content) -->
                <Image Source="avares://PhotoBooth.Event/Assets/DongFest/back/back3.png"
                       Stretch="UniformToFill"/>

                <!-- ==================== PHOTO GRID ==================== -->
                <!-- 8 thumbnails positioned over the 8 white slots in back3.png.
                     Grid origin: x=160, y=230. Cell: ~215x303. Gaps: 19px H, 30px V.
                     WrapPanel MaxWidth = (215+19)*4 = 936 → exactly 4 items per row. -->
                <ItemsControl ItemsSource="{Binding Photos}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="171,240,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="PhotoBtn"
                                    Command="{Binding $parent[ItemsControl].((vm:PhotoSelectViewModel)DataContext).ToggleSelectionCommand}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,30.5,39.5">
                                <!-- BẠN CHỈ CẦN CHỈNH SỐ WIDTH Ở DÒNG DƯỚI ĐÂY (CHIỀU CAO SẼ TỰ ĐỘNG NHÂN THEO TỶ LỆ) -->
                                <Viewbox Width="193" Stretch="Uniform">
                                    <!-- Tỷ lệ gốc của khung ảnh (không cần sửa dòng này) -->
                                    <Grid Width="195" Height="283">
                                    <!-- Photo thumbnail — Background is the fallback when image not loaded -->
                                    <Border CornerRadius="4" ClipToBounds="True" Background="#2a2a4a">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Selection highlight border -->
                                    <Border CornerRadius="4"
                                            BorderBrush="#e94560"
                                            BorderThickness="4"
                                            IsVisible="{Binding IsSelected}"/>

                                    <!-- Checkmark badge -->
                                    <Border Background="#e94560"
                                            CornerRadius="15"
                                            Width="30" Height="30"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,5,5,0"
                                            IsVisible="{Binding IsSelected}">
                                        <TextBlock Text="✓"
                                                   Foreground="White"
                                                   FontSize="16" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                </Viewbox>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ==================== FRAME PREVIEW (right side) ==================== -->
                <!-- dongfest_frame.png is 3545x5316 (portrait ~2:3). Scaled via Viewbox.
                     Transparent slots detected at pixel-exact positions, scaled ÷10 for Viewbox. -->
                <Viewbox HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,0,60,30"
                         Width="580"
                         Stretch="Uniform">
                    <Grid Width="355" Height="532">
                        <!-- Selected Photos Layer (behind frame overlay) -->
                        <Image Source="{Binding SelectedPhoto1}"
                               Stretch="UniformToFill"
                               Width="150" Height="217"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="18,18,0,0"/>
                        <Image Source="{Binding SelectedPhoto2}"
                               Stretch="UniformToFill"
                               Width="150" Height="217"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="187,18,0,0"/>
                        <Image Source="{Binding SelectedPhoto3}"
                               Stretch="UniformToFill"
                               Width="150" Height="217"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="18,252,0,0"/>
                        <Image Source="{Binding SelectedPhoto4}"
                               Stretch="UniformToFill"
                               Width="150" Height="217"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="187,252,0,0"/>

                        <!-- Frame Overlay — on top of selected photos -->
                        <Image Source="avares://PhotoBooth.Event/Assets/DongFest/frame/dongfest_frame.png"
                               Stretch="Uniform"/>
                    </Grid>
                </Viewbox>


                <!-- ==================== BUTTONS ==================== -->
                <!-- Transparent overlay buttons positioned exactly over the
                     background-drawn buttons in back3.png.
                     "← Quay lại": x=150-365, y=910-985 (216x75)
                     "Tiếp theo →": x=839-1054, y=910-985 (216x75) -->

                <!-- Back Button -->
                <!-- <Button Command="{Binding GoBackCommand}"
                        Classes="OverlayBtn"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="150,910,0,0"
                        Width="216" Height="75"/> -->

                <!-- Next/Confirm Button -->
                <Grid HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="839,910,0,0"
                      Width="216" Height="75">
                    <!-- Confirm overlay button -->
                    <Button Command="{Binding ConfirmCommand}"
                            Classes="OverlayBtn"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                    <!-- Dim overlay when confirm is disabled (< 4 photos selected) -->
                    <Border Background="#60000000"
                            CornerRadius="15"
                            IsVisible="{Binding !CanConfirm}"
                            IsHitTestVisible="False"/>
                </Grid>

            </Grid>
        </Viewbox>
    </Grid>

</UserControl>
