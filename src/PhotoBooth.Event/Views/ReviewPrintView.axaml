<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoBooth.Event.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="PhotoBooth.Event.Views.ReviewPrintView"
             x:DataType="vm:ReviewPrintViewModel"
             Background="#1a1a2e">

    <Grid>
        <!-- Content Scaler — everything inside (including background) scales together -->
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">

                <!-- Background Image -->
                <Image Source="avares://PhotoBooth.Event/Assets/DongFest/back/back4.png"
                       Stretch="UniformToFill"/>

                <!-- Status Text -->
                <TextBlock Text="{Binding StatusText}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Top" 
                           Margin="20"
                           FontSize="28" 
                           FontFamily="{StaticResource UTMCookies}"
                           Foreground="White" />

                <TextBlock HorizontalAlignment="Left" 
                           VerticalAlignment="Top" 
                           Margin="20"
                           FontSize="28" 
                           FontFamily="{StaticResource UTMCookies}"
                           Foreground="White"
                           Text="{Binding SequentialNumber}" />

                <!-- Final Image Preview -->
                <Viewbox Stretch="Uniform" Margin="60,100,60,150">
                    <Image Source="{Binding FinalImage}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" />
                </Viewbox>

                <!-- Next Button Image — same style as screen 1 -->
                <Image Source="avares://PhotoBooth.Event/Assets/DongFest/button/next_btn.png"
                       Width="180"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,40"
                       Cursor="Hand"
                       PointerPressed="OnNextBtnPressed"
                       PointerReleased="OnNextBtnReleased">
                    <Image.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="QuadraticEaseOut" />
                        </Transitions>
                    </Image.Transitions>
                </Image>

            </Grid>
        </Viewbox>
    </Grid>

</UserControl>
